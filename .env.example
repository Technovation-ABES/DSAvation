MONGODB_URI=
MONGODB_DB=dsavation
ADMIN_EMAILS=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
GITHUB_TOKEN=
SESSION_COOKIE_SECURE=false

# Frontend URL (used for logo in emails, etc.)
FRONTEND_URL=http://localhost:5173

# Email (SMTP) — Configure for sending password reset emails
# For Outlook / Office 365 (@abes.ac.in):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-outlook@outlook.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=DSAvation Club
EMAIL_FROM_EMAIL=your-outlook@outlook.com

# Alternative for Gmail (if using Gmail instead):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-gmail-app-password
