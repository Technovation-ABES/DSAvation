{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/daily-assignment",
      "schedule": "30 18 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?route=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
